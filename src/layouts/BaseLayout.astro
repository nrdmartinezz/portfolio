---
import '../index.css';
import { site } from '../config/site';
import { identityJsonLd } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  noIndex?: boolean;
  jsonLd?: unknown;
}

const {
  title,
  description,
  ogType = 'website',
  publishedTime,
  noIndex = false,
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const image = new URL(site.defaultOgImage, site.url).href;
const imageAlt = `${site.name}, web designer and full-stack developer in ${site.location.locality}, ${site.location.regionName}`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#070707" />
    <meta name="theme-color" content="#070707" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070707" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <script type="application/ld+json" set:html={JSON.stringify(identityJsonLd())} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/png" href="/images/nate-logo-dark_b3f43e9f.png" />
    <link rel="apple-touch-icon" href="/images/nate-logo-dark_b3f43e9f.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Blog`}
      href="/blog/rss.xml"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        const nodes = document.querySelectorAll<HTMLElement>('.reveal');
        const mobile = window.matchMedia('(max-width: 820px)').matches;
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            });
          },
          mobile ? { threshold: 0, rootMargin: '0px 0px 160px 0px' } : { threshold: 0.18 },
        );
        nodes.forEach((node) => observer.observe(node));
      }
    </script>
  </body>
</html>
