---
import Icon from './Icon.astro';
import SignalStack from './SignalStack.astro';

interface Props {
  eyebrow: string;
  headlineMain: string;
  headlineHighlight: string;
  intro: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  artSrc: string;
  artAlt: string;
  artNoteLabel: string;
  artNoteValue: string;
  footerLine1: string;
}

const {
  eyebrow,
  headlineMain,
  headlineHighlight,
  intro,
  primaryCta,
  secondaryCta,
  artSrc,
  artAlt,
  artNoteLabel,
  artNoteValue,
  footerLine1,
} = Astro.props;
---

<section class="hero section-pad" aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__copy reveal">
      <div class="eyebrow">
        <SignalStack horizontal />
        <span>{eyebrow}</span>
      </div>
      <h1 id="hero-title">
        {headlineMain}
        <br />
        <span>{headlineHighlight}</span>
      </h1>
      <p class="hero__intro">{intro}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={primaryCta.href}>
          {primaryCta.label}
          <Icon name="arrow-down-right" size={18} />
        </a>
        <a class="text-link" href={secondaryCta.href} target="_blank" rel="noreferrer">
          {secondaryCta.label}
          <Icon name="download" size={17} />
        </a>
      </div>
    </div>

    <div class="hero__art reveal reveal-x">
      <img src={artSrc} alt={artAlt} />
      <div class="hero__art-note">
        <span>{artNoteLabel}</span>
        <strong>{artNoteValue}</strong>
      </div>
    </div>
  </div>

  <div class="hero__footer">
    <p>{footerLine1}</p>
    <a href={primaryCta.href}>
      Scroll to work <Icon name="arrow-down-right" size={15} />
    </a>
  </div>
</section>
