---
interface Props {
  horizontal?: boolean;
}

const { horizontal = false } = Astro.props;
---

<span class:list={["signal-stack", { "signal-stack--horizontal": horizontal }]} aria-hidden="true">
  <i class="signal signal--yellow"></i>
  <i class="signal signal--red"></i>
  <i class="signal signal--blue"></i>
</span>
