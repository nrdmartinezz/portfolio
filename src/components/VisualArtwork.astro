---
import SignalStack from './SignalStack.astro';

interface Props {
  variant: string;
  label: string;
}

const { variant, label } = Astro.props;
---

<div class={`visual-art visual-art--${variant}`} role="img" aria-label={label}>
  <div class="visual-art__grid" aria-hidden="true"></div>
  <div class="visual-art__plane visual-art__plane--one" aria-hidden="true"></div>
  <div class="visual-art__plane visual-art__plane--two" aria-hidden="true"></div>
  <div class="visual-art__arc" aria-hidden="true"></div>
  <div class="visual-art__disc" aria-hidden="true"></div>
  <div class="visual-art__line" aria-hidden="true"></div>
  <SignalStack />
  <span class="visual-art__stamp" aria-hidden="true">NM / SYS</span>
</div>
