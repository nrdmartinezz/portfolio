---
import Icon from "./Icon.astro";
import SignalStack from "./SignalStack.astro";
import Wordmark from "./Wordmark.astro";
import type { NavItem } from "../data/home";

interface Props {
  nav: NavItem[];
  logoSrc: string;
  contactHref: string;
}

const { nav, logoSrc, contactHref } = Astro.props;
const onHome = Astro.url.pathname === "/";

function resolveHref(href: string) {
  if (href.startsWith("#") && !onHome) return `/${href}`;
  return href;
}
---

<header class="site-header">
  <Wordmark logoSrc={logoSrc} href={onHome ? "#top" : "/#top"} />

  <nav class="desktop-nav" aria-label="Primary navigation">
    {
      nav.map((item) => (
        <a href={resolveHref(item.href)}>{item.label}</a>
      ))
    }
  </nav>

  <a class="header-contact" href={contactHref}>
    Let's talk <Icon name="arrow-up-right" size={16} />
  </a>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-navigation"
    aria-label="Open menu"
  >
    <Icon name="menu" size={22} />
    <Icon name="x" size={22} />
  </button>

  <nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation">
    <div class="mobile-nav__label">
      <span>Studio index</span>
      <SignalStack horizontal />
    </div>
    {
      nav.map((item, index) => (
        <a href={resolveHref(item.href)}>
          <span>0{index + 1}</span>
          {item.label}
          <Icon name="arrow-down-right" size={18} />
        </a>
      ))
    }
  </nav>
</header>

<script>
  const headers = document.querySelectorAll<HTMLElement>(".site-header");

  headers.forEach((header) => {
    const button = header.querySelector<HTMLButtonElement>(".menu-toggle");
    const links = header.querySelectorAll<HTMLAnchorElement>(".mobile-nav a");
    if (!button) return;

    const setOpen = (open: boolean) => {
      header.classList.toggle("is-menu-open", open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    button.addEventListener("click", () => {
      setOpen(!header.classList.contains("is-menu-open"));
    });

    links.forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
  });
</script>
