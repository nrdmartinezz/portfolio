---
import type { GetStaticPaths } from 'astro';
import ContactSection from '../../components/ContactSection.astro';
import PracticeDetail from '../../components/PracticeDetail.astro';
import { areas } from '../../data/areas';
import { contact } from '../../data/home';
import { services } from '../../data/services';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFrame from '../../layouts/SiteFrame.astro';
import { areaPageJsonLd } from '../../lib/schema';

export const getStaticPaths = (() => {
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}) satisfies GetStaticPaths;

interface Props {
  area: (typeof areas)[number];
}

const { area } = Astro.props;

const related = [
  ...services.map((service) => ({
    href: `/services/${service.slug}/`,
    label: service.label,
  })),
  ...areas
    .filter((item) => item.slug !== area.slug)
    .map((item) => ({ href: `/areas/${item.slug}/`, label: item.city })),
];
---

<BaseLayout title={area.title} description={area.description} jsonLd={areaPageJsonLd(area)}>
  <SiteFrame>
    <PracticeDetail
      parent={{ href: '/areas/', label: 'Areas' }}
      kicker={area.kicker}
      heading={area.heading}
      answer={area.answer}
      blockHeading={`Working in ${area.city}`}
      blocks={[...area.local]}
      steps={area.steps}
      proof={area.proof}
      faqs={area.faqs}
      related={related}
    />
    <ContactSection {...contact} defaultCity={area.slug} />
  </SiteFrame>
</BaseLayout>
