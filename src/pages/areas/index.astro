---
import ContactSection from '../../components/ContactSection.astro';
import PracticeIndex from '../../components/PracticeIndex.astro';
import { areaLinks, serviceLinks } from '../../data/local';
import { contact } from '../../data/home';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFrame from '../../layouts/SiteFrame.astro';
import { collectionJsonLd } from '../../lib/schema';

const heading = 'Lake Elsinore and southwest Riverside County';
const answer =
  'Nate Martinez is based in Lake Elsinore and works with businesses in Temecula, Murrieta, Menifee, Wildomar, and Corona. Each city page describes that place. He does not publish a street address.';

const jsonLd = collectionJsonLd({
  path: '/areas/',
  name: heading,
  description: answer,
  items: areaLinks.map((item) => ({
    name: item.label,
    url: new URL(item.href, site.url).href,
  })),
});
---

<BaseLayout title={`${heading} — Nate Martinez`} description={answer} jsonLd={jsonLd}>
  <SiteFrame>
    <PracticeIndex
      kicker={{ href: '/', label: 'Home' }}
      heading={heading}
      answer={answer}
      items={areaLinks}
      asideHeading="Services"
      aside={serviceLinks}
    />
    <ContactSection {...contact} />
  </SiteFrame>
</BaseLayout>
