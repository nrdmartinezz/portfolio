---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFrame from '../../layouts/SiteFrame.astro';
import { getPublished, postDateFormat, readingTime, type PostEntry } from '../../lib/posts';
import { blogPostingJsonLd } from '../../lib/schema';

export const getStaticPaths = (async () => {
  const entries = await getPublished();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: PostEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const minutes = await readingTime(entry);
const jsonLd = blogPostingJsonLd({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
});
---

<BaseLayout
  title={`${entry.data.title} — Nate Martinez`}
  description={entry.data.description}
  ogType="article"
  publishedTime={entry.data.date.toISOString()}
  jsonLd={jsonLd}
>
  <SiteFrame>
    <article class="blog-page section-pad">
      <p class="blog-kicker">
        <a href="/blog/">Blog</a>
        <span aria-hidden="true"> / </span>
        <time datetime={entry.data.date.toISOString()}
          >{postDateFormat.format(entry.data.date)}</time
        >
        <span> · {minutes}</span>
      </p>
      <header class="section-intro section-intro--stacked">
        <h1>{entry.data.title}</h1>
        <p>{entry.data.description}</p>
      </header>
      <div class="blog-prose">
        <Content />
      </div>
    </article>
  </SiteFrame>
</BaseLayout>
