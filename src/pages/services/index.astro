---
import ContactSection from '../../components/ContactSection.astro';
import PracticeIndex from '../../components/PracticeIndex.astro';
import { areaLinks, serviceLinks } from '../../data/local';
import { contact } from '../../data/home';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFrame from '../../layouts/SiteFrame.astro';
import { collectionJsonLd } from '../../lib/schema';

const heading = 'Web development, local SEO, and social media';
const answer =
  'Nate Martinez offers three services from Lake Elsinore: web design and development, local SEO, and social media management. Hire one, or more than one. The offer, the city, and the next step stay consistent either way.';

const jsonLd = collectionJsonLd({
  path: '/services/',
  name: heading,
  description: answer,
  items: serviceLinks.map((item) => ({
    name: item.label,
    url: new URL(item.href, site.url).href,
  })),
});
---

<BaseLayout title={`${heading} — Nate Martinez`} description={answer} jsonLd={jsonLd}>
  <SiteFrame>
    <PracticeIndex
      kicker={{ href: '/', label: 'Home' }}
      heading={heading}
      answer={answer}
      items={serviceLinks}
      asideHeading="Cities"
      aside={areaLinks}
    />
    <ContactSection {...contact} />
  </SiteFrame>
</BaseLayout>
