---
import ContactSection from '../../components/ContactSection.astro';
import PracticeIndex from '../../components/PracticeIndex.astro';
import { areaLinks, serviceLinks } from '../../data/local';
import { contact } from '../../data/home';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFrame from '../../layouts/SiteFrame.astro';
import { collectionJsonLd } from '../../lib/schema';

const heading = 'Web design, local SEO, and social media';
const answer =
  'I’m based in Lake Elsinore and offer web design and development, local SEO, and social media management. You can hire me for one part of the work or bring them together around the same goal.';
const title = 'Web Design, Local SEO & Social Media | Nate Martinez';
const description =
  'Explore my web design and development, local SEO, and social media services for businesses in Lake Elsinore and nearby cities.';

const jsonLd = collectionJsonLd({
  path: '/services/',
  name: heading,
  description,
  items: serviceLinks.map((item) => ({
    name: item.label,
    url: new URL(item.href, site.url).href,
  })),
});
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <SiteFrame>
    <PracticeIndex
      kicker={{ href: '/', label: 'Home' }}
      heading={heading}
      answer={answer}
      items={serviceLinks}
      asideHeading="Cities"
      aside={areaLinks}
    />
    <ContactSection {...contact} />
  </SiteFrame>
</BaseLayout>
